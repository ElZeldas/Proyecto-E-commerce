# ============================================================================
# CONFIGURACIÓN DE ENTORNO - MICROSIP ERP READ-ONLY API
# Copie este archivo a .env y ajuste los valores según su entorno local
# ============================================================================

# --- Conexión Remota TCP/IP a Firebird (Servidor Microsip) ---
MICROSIP_DB_HOST=192.168.1.5
MICROSIP_DB_PORT=3050
MICROSIP_DB_PATH=E:\Microsip datos\CAPACITACION.FDB
MICROSIP_DB_CHARSET=WIN1252
MICROSIP_DB_TIMEOUT=10

# --- Credenciales de Servicio (Opcional para Health Check / Inspector CLI) ---
# Nota: El endpoint POST /login autentica directamente con las credenciales
# de Microsip proporcionadas por el usuario en la petición.
MICROSIP_DB_USER=SYSDBA
MICROSIP_DB_PASSWORD=

# --- Ruta de Librería Cliente Firebird (fbclient.dll) ---
# Dejar vacío para autodetección automática en rutas estándar de Windows/Microsip
FIREBIRD_CLIENT_LIBRARY=

# --- Seguridad JWT ---
JWT_SECRET_KEY=CAMBIAR_POR_LLAVE_SECRETA_EMPRESARIAL_DE_256_BITS_EN_PRODUCCION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- Servidor API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=production
CORS_ORIGINS=*

# --- Configuración de Logs ---
LOG_FILE_PATH=logs/api.log
LOG_LEVEL=INFO
INSPECTION_REPORT_PATH=logs/inspection_report.json
